#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# sonoff-ctl: Zero-dependency Local LAN Controller for Stock eWeLink / Sonoff
# Copy to gateway/secrets/sonoff-ctl (or /usr/local/bin/sonoff-ctl)
# Supports single-channel (plug/light) and multi-channel (Sonoff 4CH Pro / strip)
# Includes `fetch-keys` to pull devicekeys directly from your eWeLink account!
# ==============================================================================

DEVICES_FILE="${SONOFF_DEVICES_FILE:-/data/picoclaw/secrets/sonoff-devices.json}"
EWELINK_APP_ID="R8Oq3y0eSZSYdKccHlrQzT1ACCOUT9Gv"
EWELINK_APP_SECRET="1ve5Qk9GXfUhKAn1svnKwpAlxXkMarru"

usage() {
  cat <<EOF
Usage:
  sonoff-ctl list
      List configured Sonoff devices from $DEVICES_FILE

  sonoff-ctl fetch-keys <email> <password> [region=eu] [country_code=+30]
      Log into eWeLink Cloud once, fetch all device IDs and local LAN devicekeys,
      and update $DEVICES_FILE automatically.

  sonoff-ctl set-device <name> <ip> <deviceid> <devicekey> [channels=4]
      Register or update a Sonoff device manually in $DEVICES_FILE

  sonoff-ctl switch <name-or-deviceid> <channel:1-4> <on|off>
      Control a Sonoff (e.g. Sonoff 4CH Pro) over Local LAN (:8081)
      Example: sonoff-ctl switch 4chpro 1 on

  sonoff-ctl pulse <name-or-deviceid> <channel:1-4> <seconds>
      Turn ON a channel, wait <seconds>, and turn it OFF
      Example: sonoff-ctl pulse 4chpro 1 60
EOF
}

ensure_devices_file() {
  mkdir -p "$(dirname "$DEVICES_FILE")"
  if [ ! -f "$DEVICES_FILE" ]; then
    cat <<'JSON' > "$DEVICES_FILE"
{
  "4chpro": {
    "name": "Sonoff 4CH Pro",
    "ip": "192.168.1.165",
    "port": 8081,
    "deviceid": "YOUR_10_CHAR_DEVICE_ID",
    "devicekey": "YOUR_36_CHAR_EWELINK_DEVICEKEY",
    "channels": 4,
    "type": "strip"
  }
}
JSON
    chmod 600 "$DEVICES_FILE"
  fi
}

fetch_ewelink_keys() {
  local user="$1"
  local pass="$2"
  local region="${3:-eu}"
  local cc="${4:-+30}"

  local body
  if [[ "$user" == *"@"* ]]; then
    body="$(jq -nc --arg u "$user" --arg p "$pass" --arg c "$cc" '{email: $u, password: $p, countryCode: $c}')"
  else
    body="$(jq -nc --arg u "$user" --arg p "$pass" --arg c "$cc" '{phoneNumber: $u, password: $p, countryCode: $c}')"
  fi

  local sign
  sign="$(printf '%s' "$body" | openssl dgst -sha256 -hmac "$EWELINK_APP_SECRET" -binary | openssl base64 -A)"
  local nonce
  nonce="$(openssl rand -hex 4)"

  echo "Authenticating with eWeLink Cloud (${region}-apia.coolkit.cc)..."
  local resp
  resp="$(curl -fsSL -X POST "https://${region}-apia.coolkit.cc/v2/user/login" \
    -H "X-CK-Appid: $EWELINK_APP_ID" \
    -H "X-CK-Nonce: $nonce" \
    -H "Authorization: Sign $sign" \
    -H "Content-Type: application/json" \
    -d "$body")"

  local err
  err="$(echo "$resp" | jq -r '.error // 0')"

  if [ "$err" = "10004" ]; then
    local new_region
    new_region="$(echo "$resp" | jq -r '.data.region // empty')"
    if [ -n "$new_region" ]; then
      echo "Redirecting to region '$new_region'..."
      fetch_ewelink_keys "$user" "$pass" "$new_region" "$cc"
      return $?
    fi
  fi

  if [ "$err" != "0" ]; then
    echo "ERROR: eWeLink login failed: $(echo "$resp" | jq -c .)" >&2
    return 1
  fi

  local at
  at="$(echo "$resp" | jq -r '.data.at // empty')"
  local things_resp
  things_resp="$(curl -fsSL -X GET "https://${region}-apia.coolkit.cc/v2/device/thing?num=0" \
    -H "X-CK-Appid: $EWELINK_APP_ID" \
    -H "X-CK-Nonce: $nonce" \
    -H "Authorization: Bearer $at" \
    -H "Content-Type: application/json")"

  local tmp_cfg
  tmp_cfg="$(mktemp /tmp/sonoff-sync.XXXXXX)"
  cp "$DEVICES_FILE" "$tmp_cfg"

  echo "$things_resp" | jq -c '.data.thingList[]?.itemData // empty' | while read -r item; do
    local devid name devkey uiid channels slug ip
    devid="$(echo "$item" | jq -r '.deviceid // empty')"
    name="$(echo "$item" | jq -r '.name // empty')"
    devkey="$(echo "$item" | jq -r '.devicekey // .apikey // empty')"
    uiid="$(echo "$item" | jq -r '.extra.uiid // 1')"
    [ -z "$devid" ] || [ -z "$devkey" ] && continue

    channels=1
    if [ "$uiid" = "4" ] || [ "$uiid" = "8" ] || [ "$uiid" = "77" ] || [ "$uiid" = "126" ]; then
      channels=4
    fi

    ip="$(jq -r --arg id "$devid" '(.[] | select(.deviceid == $id) | .ip) // empty' "$tmp_cfg")"
    slug="$(echo "$name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/_/g; s/^_+|_+$//g')"
    [ -z "$slug" ] && slug="sonoff_${devid}"

    jq --arg slug "$slug" \
       --arg name "$name" \
       --arg ip "$ip" \
       --arg id "$devid" \
       --arg key "$devkey" \
       --argjson ch "$channels" \
       --argjson uiid "$uiid" \
       '.[$slug] = {name: $name, ip: $ip, port: 8081, deviceid: $id, devicekey: $key, channels: $ch, uiid: $uiid}' \
       "$tmp_cfg" > "${tmp_cfg}.next" && mv "${tmp_cfg}.next" "$tmp_cfg"
    echo "  +Synced: $slug ($name) [id=$devid, ip=${ip:-set-via-set-device}, channels=$channels]"
  done

  mv "$tmp_cfg" "$DEVICES_FILE"
  chmod 600 "$DEVICES_FILE"
  echo "Successfully updated $DEVICES_FILE"
}

send_lan_encrypted() {
  local ip="$1"
  local port="$2"
  local endpoint="$3"
  local deviceid="$4"
  local devicekey="$5"
  local inner_json="$6"

  local key_hex
  key_hex="$(printf '%s' "$devicekey" | openssl dgst -md5 -r | awk '{print $1}')"
  local iv_str
  iv_str="$(printf '%08d%08d' $((RANDOM * RANDOM % 100000000)) $((RANDOM * RANDOM % 100000000)))"
  local iv_hex
  iv_hex="$(printf '%s' "$iv_str" | od -An -tx1 | tr -d ' \n')"
  local iv_b64
  iv_b64="$(printf '%s' "$iv_str" | openssl base64 -A)"
  local data_b64
  data_b64="$(printf '%s' "$inner_json" | openssl enc -aes-128-cbc -e -base64 -A -K "$key_hex" -iv "$iv_hex")"
  local seq
  seq="$(date +%s)000"

  local payload
  payload="$(jq -nc \
    --arg seq "$seq" \
    --arg id "$deviceid" \
    --arg iv "$iv_b64" \
    --arg data "$data_b64" \
    '{sequence: $seq, deviceid: $id, selfApikey: "123", iv: $iv, encrypt: true, data: $data}')"

  curl -fsSL -X POST "http://${ip}:${port}${endpoint}" \
    -H "Content-Type: application/json" \
    --connect-timeout 3 \
    --max-time 5 \
    -d "$payload"
  echo ""
}

ensure_devices_file
CMD="${1:-help}"

case "$CMD" in
  list) jq . "$DEVICES_FILE" ;;
  fetch-keys) fetch_ewelink_keys "${2:?Email/Phone required}" "${3:?Password required}" "${4:-eu}" "${5:-+30}" ;;
  set-device)
    NAME="${2:?}"; IP="${3:?}"; DEVID="${4:?}"; DEVKEY="${5:?}"; CHANNELS="${6:-4}"
    TMP="$(mktemp /tmp/sonoff-dev.XXXXXX)"
    jq --arg name "$NAME" --arg ip "$IP" --arg id "$DEVID" --arg key "$DEVKEY" --argjson ch "$CHANNELS" \
       '.[$name] = {name: $name, ip: $ip, port: 8081, deviceid: $id, devicekey: $key, channels: $ch}' \
       "$DEVICES_FILE" > "$TMP" && mv "$TMP" "$DEVICES_FILE"
    chmod 600 "$DEVICES_FILE"
    ;;
  switch)
    TARGET="${2:?}"; CH_HUMAN="${3:?}"; STATE_LC="$(echo "${4:?}" | tr '[:upper:]' '[:lower:]')"
    OUTLET=$((CH_HUMAN - 1))
    DEV_JSON="$(jq -r --arg t "$TARGET" '.[$t] // (.[] | select(.deviceid == $t)) // empty' "$DEVICES_FILE")"
    IP="$(echo "$DEV_JSON" | jq -r '.ip')"; PORT="$(echo "$DEV_JSON" | jq -r '.port // 8081')"
    DEVID="$(echo "$DEV_JSON" | jq -r '.deviceid')"; DEVKEY="$(echo "$DEV_JSON" | jq -r '.devicekey')"
    CHANNELS="$(echo "$DEV_JSON" | jq -r '.channels // 4')"
    if [ "$CHANNELS" -gt 1 ]; then
      INNER="$(jq -nc --arg s "$STATE_LC" --argjson o "$OUTLET" '{switches: [{switch: $s, outlet: $o}]}')"
      send_lan_encrypted "$IP" "$PORT" "/zeroconf/switches" "$DEVID" "$DEVKEY" "$INNER"
    else
      INNER="$(jq -nc --arg s "$STATE_LC" '{switch: $s}')"
      send_lan_encrypted "$IP" "$PORT" "/zeroconf/switch" "$DEVID" "$DEVKEY" "$INNER"
    fi
    ;;
  pulse)
    "$0" switch "${2:?}" "${3:?}" on
    sleep "${4:-60}"
    "$0" switch "${2:?}" "${3:?}" off
    ;;
  *) usage ;;
esac
