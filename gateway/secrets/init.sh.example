#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# Example Private Boot Hook (gateway/secrets/init.sh)
# Copy to gateway/secrets/init.sh (or /data/picoclaw/secrets/init.sh)
# ==============================================================================

echo "[secrets/init.sh] Setting up Sonoff LAN controller, Local NCNN + Cloud Vision checker, go2rtc, and Dagu..."

mkdir -p /data/picoclaw/addons/bin /data/dagu/dags /data/dagu/data /data/go2rtc /tmp/dagu-logs /usr/local/share/models

# 1. Install sonoff-ctl and vision-human-check CLIs
for tool in sonoff-ctl vision-human-check; do
  for src in "/data/picoclaw/secrets/$tool" "/app/secrets/$tool"; do
    if [ -f "$src" ]; then
      install -m 0755 "$src" "/usr/local/bin/$tool"
      break
    fi
  done
done

# 1b. Install local ARMv7 NEON NCNN human detector & YOLO-FastestV2 weights
for src_dir in "/data/picoclaw/secrets" "/app/secrets"; do
  if [ -x "$src_dir/bin/local-human-detect" ]; then
    ln -sf "$src_dir/bin/local-human-detect" /usr/local/bin/local-human-detect
    break
  fi
done
for src_dir in "/data/picoclaw/secrets/models" "/app/secrets/models"; do
  if [ -f "$src_dir/yolo-fastestv2-opt.param" ]; then
    ln -sf "$src_dir/yolo-fastestv2-opt.param" /usr/local/share/models/yolo-fastestv2-opt.param
    ln -sf "$src_dir/yolo-fastestv2-opt.bin" /usr/local/share/models/yolo-fastestv2-opt.bin
    break
  fi
done

# 2. Link Dagu and go2rtc binaries from persistent /data/picoclaw/addons/bin
if [ -x /data/picoclaw/addons/bin/dagu ]; then
  ln -sf /data/picoclaw/addons/bin/dagu /usr/local/bin/dagu
fi
if [ -x /data/picoclaw/addons/bin/go2rtc ]; then
  ln -sf /data/picoclaw/addons/bin/go2rtc /usr/local/bin/go2rtc
fi

# 3. Configure go2rtc for ONVIF / RTSP cameras
cat <<'YAML' > /data/go2rtc/go2rtc.yaml
api:
  listen: ":1984"
  origin: "*"

rtsp:
  listen: ":8554"

streams:
  cam_example:
    - rtsp://username:password@192.168.1.185:554/ch0
  cam_example_sub:
    - rtsp://username:password@192.168.1.185:554/ch1
  cam_example_snap:
    - http://192.168.1.185/x/ch1.jpg?token=YOUR_CAMERA_API_TOKEN
YAML

if [ -x /usr/local/bin/go2rtc ] && ! pgrep -x go2rtc >/dev/null 2>&1; then
  GOMEMLIMIT=32MiB GOGC=50 /usr/local/bin/go2rtc -config /data/go2rtc/go2rtc.yaml >/tmp/picoclaw-logs/go2rtc.log 2>&1 &
fi

# 4. Configure Dagu Visual Rule: Night Human Detection (Local NCNN + Cloud LLM Cascade) -> Sonoff 4CH Pro Ch1 (60s)
cat <<'YAML' > /data/dagu/dags/night_human_motion_light.yaml
description: "When camera detects a human at night (Tier 1 Local NCNN -> Tier 2 Cloud LLM / Offline Fallback) -> Turn ON Sonoff 4CH Pro Ch1 for 1 min"
params:
  - CAMERA_IP: "192.168.1.185"
  - CAMERA_TOKEN: "YOUR_CAMERA_API_TOKEN"
  - CAMERA_SNAP_STREAM: "cam_example_snap"
  - SONOFF_DEVICE: "4chpro"
  - SONOFF_CHANNEL: "1"
  - DURATION_SECONDS: "60"
  - FORCE_NIGHT: "false"
  - LOCAL_HIGH_CONF: "0.65"
  - LOCAL_LOW_CONF: "0.15"
  - LOCAL_OFFLINE_CONF: "0.30"
steps:
  - name: check_is_night
    command: |
      if [ "${FORCE_NIGHT}" = "true" ]; then
        echo "FORCE_NIGHT=true override enabled; proceeding."
        exit 0
      fi
      MODE=$(curl -fsSL "http://${CAMERA_IP}/x/json-daynight-sensors.cgi?token=${CAMERA_TOKEN}" 2>/dev/null | jq -r '.mode // empty' | tr '[:upper:]' '[:lower:]')
      HOUR=$(date +%H)
      echo "Camera sensor mode: ${MODE:-unknown}, Local hour: ${HOUR}"
      if [ "$MODE" = "night" ] || [ "$HOUR" -ge 19 ] || [ "$HOUR" -lt 6 ]; then
        echo "Night condition satisfied."
        exit 0
      fi
      echo "Daytime detected (mode=$MODE, hour=$HOUR); skipping rule."
      exit 1

  - name: capture_snapshot
    command: |
      curl -fsSL "http://${CAMERA_IP}/x/motion_latest.jpg?token=${CAMERA_TOKEN}" -o /tmp/motion_${CAMERA_SNAP_STREAM}.jpg
      curl -fsSL "http://${CAMERA_IP}/x/motion_bg.jpg?token=${CAMERA_TOKEN}" -o /tmp/bg_${CAMERA_SNAP_STREAM}.jpg 2>/dev/null || true
      ls -lh /tmp/motion_${CAMERA_SNAP_STREAM}.jpg /tmp/bg_${CAMERA_SNAP_STREAM}.jpg
    depends:
      - check_is_night

  - name: detect_human_local_ncnn
    command: |
      rm -f /tmp/local_detect_${CAMERA_SNAP_STREAM}.json
      if [ -s /tmp/bg_${CAMERA_SNAP_STREAM}.jpg ]; then
        /usr/local/bin/local-human-detect /tmp/motion_${CAMERA_SNAP_STREAM}.jpg /tmp/bg_${CAMERA_SNAP_STREAM}.jpg | tee /tmp/local_detect_${CAMERA_SNAP_STREAM}.json
      else
        /usr/local/bin/local-human-detect /tmp/motion_${CAMERA_SNAP_STREAM}.jpg | tee /tmp/local_detect_${CAMERA_SNAP_STREAM}.json
      fi
    depends:
      - capture_snapshot

  - name: verify_human_cascade
    command: |
      LOCAL_DETECT_JSON=/tmp/local_detect_${CAMERA_SNAP_STREAM}.json \
      LOCAL_HIGH_CONF=${LOCAL_HIGH_CONF} \
      LOCAL_LOW_CONF=${LOCAL_LOW_CONF} \
      LOCAL_OFFLINE_CONF=${LOCAL_OFFLINE_CONF} \
      /usr/local/bin/vision-human-check --cascade /tmp/motion_${CAMERA_SNAP_STREAM}.jpg /tmp/bg_${CAMERA_SNAP_STREAM}.jpg
    depends:
      - detect_human_local_ncnn

  - name: turn_on_4ch_ch1_1min
    command: /usr/local/bin/sonoff-ctl pulse ${SONOFF_DEVICE} ${SONOFF_CHANNEL} ${DURATION_SECONDS}
    depends:
      - verify_human_cascade
YAML

# 5. Start Dagu Visual Workflow Engine & Scheduler on :8085
cat <<'YAML' > /data/dagu/config.yaml
host: "0.0.0.0"
port: 8085
dags_dir: "/data/dagu/dags"
log_dir: "/tmp/dagu-logs"
data_dir: "/data/dagu/data"
auth:
  mode: "none"
YAML

if [ -x /usr/local/bin/dagu ] && ! pgrep -x dagu >/dev/null 2>&1; then
  export DAGU_HOME="/data/dagu"
  export DAGU_DAGS_DIR="/data/dagu/dags"
  export DAGU_LOG_DIR="/tmp/dagu-logs"
  export DAGU_DATA_DIR="/data/dagu/data"
  export DAGU_COORDINATOR_ENABLED="false"
  GOMEMLIMIT=48MiB GOGC=50 /usr/local/bin/dagu start-all --config=/data/dagu/config.yaml --host=0.0.0.0 --port=8085 --dags=/data/dagu/dags >/tmp/picoclaw-logs/dagu.log 2>&1 &
fi
