#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# Example Custom Startup Hook (/app/secrets/init.sh or /data/picoclaw/secrets/init.sh)
# Copy to gateway/secrets/init.sh to enable:
#   - go2rtc (ONVIF / RTSP / Thingino camera restreamer & snapshot API on :1984)
#   - Dagu (Declarative YAML Visual Workflow & Rule Engine on :8085 + MCP server)
#   - sonoff-ctl (Local LAN controller for stock eWeLink / Sonoff switches)
#   - vision-human-check (AI Vision classifier for camera snapshots)
# ==============================================================================

mkdir -p /data/picoclaw/addons/bin /data/dagu/dags /data/dagu/data /data/go2rtc /tmp/dagu-logs

# 1. Install helper CLIs from secrets/ if present
for tool in sonoff-ctl vision-human-check; do
  for src in "/data/picoclaw/secrets/$tool" "/app/secrets/$tool"; do
    if [ -f "$src" ]; then
      install -m 0755 "$src" "/usr/local/bin/$tool"
      break
    fi
  done
done

# 2. Download or link Dagu & go2rtc static binaries (cached on /data/picoclaw/addons/bin)
ARCH="$(cat /etc/apk/arch 2>/dev/null || uname -m)"
case "$ARCH" in
  armhf|armv6*) DAGU_ARCH="armv6"; GO2RTC_ARCH="armv6" ;;
  armv7*)       DAGU_ARCH="armv7"; GO2RTC_ARCH="arm"   ;;
  aarch64|arm64) DAGU_ARCH="arm64"; GO2RTC_ARCH="arm64" ;;
  *)            DAGU_ARCH="amd64"; GO2RTC_ARCH="amd64" ;;
esac

if [ ! -x /data/picoclaw/addons/bin/go2rtc ]; then
  curl -fsSL "https://github.com/AlexxIT/go2rtc/releases/latest/download/go2rtc_linux_${GO2RTC_ARCH}" \
    -o /data/picoclaw/addons/bin/go2rtc && chmod 0755 /data/picoclaw/addons/bin/go2rtc || true
fi
if [ ! -x /data/picoclaw/addons/bin/dagu ]; then
  DAGU_VER="2.26.0"
  curl -fsSL "https://github.com/dagucloud/dagu/releases/download/v${DAGU_VER}/dagu_${DAGU_VER}_linux_${DAGU_ARCH}.tar.gz" \
    -o /tmp/dagu.tar.gz && tar -xzf /tmp/dagu.tar.gz -C /tmp dagu && \
    install -m 0755 /tmp/dagu /data/picoclaw/addons/bin/dagu && rm -f /tmp/dagu.tar.gz /tmp/dagu || true
fi

[ -x /data/picoclaw/addons/bin/dagu ] && ln -sf /data/picoclaw/addons/bin/dagu /usr/local/bin/dagu
[ -x /data/picoclaw/addons/bin/go2rtc ] && ln -sf /data/picoclaw/addons/bin/go2rtc /usr/local/bin/go2rtc

# 3. Configure go2rtc (:1984 WebUI)
if [ ! -f /data/go2rtc/go2rtc.yaml ]; then
  cat <<'YAML' > /data/go2rtc/go2rtc.yaml
api:
  listen: ":1984"
  origin: "*"

rtsp:
  listen: ":8554"

streams:
  front_cam:
    - rtsp://thingino:thingino@192.168.1.185:554/ch0
  front_cam_snap:
    - http://192.168.1.185/x/ch0.jpg?token=YOUR_CAMERA_API_TOKEN
  front_cam_onvif:
    - onvif://thingino:thingino@192.168.1.185:80
YAML
fi

if [ -x /usr/local/bin/go2rtc ] && ! pgrep -x go2rtc >/dev/null 2>&1; then
  GOMEMLIMIT=32MiB GOGC=50 /usr/local/bin/go2rtc -config /data/go2rtc/go2rtc.yaml >/tmp/picoclaw-logs/go2rtc.log 2>&1 &
fi

# 4. Seed example Dagu rule (Night Human Motion -> Turn ON Sonoff 4CH Pro Channel 1 for 60s)
if [ ! -f /data/dagu/dags/night_human_motion_light.yaml ]; then
  cat <<'YAML' > /data/dagu/dags/night_human_motion_light.yaml
description: "When camera detects a human at night -> Turn ON Sonoff 4CH Pro Channel 1 for 1 min (60s)"
params:
  - CAMERA_IP: "192.168.1.185"
  - CAMERA_TOKEN: "YOUR_CAMERA_API_TOKEN"
  - CAMERA_SNAP_STREAM: "front_cam_snap"
  - SONOFF_DEVICE: "4chpro"
  - SONOFF_CHANNEL: "1"
  - DURATION_SECONDS: "60"
  - FORCE_NIGHT: "false"
steps:
  - name: check_is_night
    command: |
      if [ "${FORCE_NIGHT}" = "true" ]; then exit 0; fi
      MODE=$(curl -fsSL "http://${CAMERA_IP}/x/json-daynight-sensors.cgi?token=${CAMERA_TOKEN}" 2>/dev/null | jq -r '.mode // empty' | tr '[:upper:]' '[:lower:]')
      HOUR=$(date +%H)
      if [ "$MODE" = "night" ] || [ "$HOUR" -ge 19 ] || [ "$HOUR" -lt 6 ]; then exit 0; fi
      exit 1

  - name: capture_snapshot
    command: curl -fsSL "http://127.0.0.1:1984/api/frame.jpeg?src=${CAMERA_SNAP_STREAM}" -o /tmp/motion_${CAMERA_SNAP_STREAM}.jpg
    depends:
      - check_is_night

  - name: detect_human_ai
    command: /usr/local/bin/vision-human-check /tmp/motion_${CAMERA_SNAP_STREAM}.jpg
    depends:
      - capture_snapshot

  - name: turn_on_4ch_ch1_1min
    command: /usr/local/bin/sonoff-ctl pulse ${SONOFF_DEVICE} ${SONOFF_CHANNEL} ${DURATION_SECONDS}
    depends:
      - detect_human_ai
YAML
fi

# 5. Start Dagu Visual Workflow Engine & Scheduler on :8085
cat <<'YAML' > /data/dagu/config.yaml
host: "0.0.0.0"
port: 8085
dags_dir: "/data/dagu/dags"
log_dir: "/tmp/dagu-logs"
data_dir: "/data/dagu/data"
auth:
  mode: "none"
YAML

if [ -x /usr/local/bin/dagu ] && ! pgrep -x dagu >/dev/null 2>&1; then
  export DAGU_HOME="/data/dagu"
  export DAGU_DAGS_DIR="/data/dagu/dags"
  export DAGU_LOG_DIR="/tmp/dagu-logs"
  export DAGU_DATA_DIR="/data/dagu/data"
  export DAGU_COORDINATOR_ENABLED="false"
  GOMEMLIMIT=48MiB GOGC=50 /usr/local/bin/dagu start-all --config=/data/dagu/config.yaml --host=0.0.0.0 --port=8085 --dags=/data/dagu/dags >/tmp/picoclaw-logs/dagu.log 2>&1 &
fi
