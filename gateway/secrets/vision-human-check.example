#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# vision-human-check: Inspects a camera JPEG frame using PicoClaw's Codex OAuth
# (or OpenAI API key) and exits 0 if a human/person is detected, or 1 if not.
# Copy to gateway/secrets/vision-human-check
# ==============================================================================

IMAGE_PATH="${1:?Usage: vision-human-check /path/to/snapshot.jpg}"
AUTH_FILE="${PICOCLAW_HOME:-/root/.picoclaw}/auth.json"
MODEL="${VISION_MODEL:-gpt-5.4}"

if [ ! -f "$IMAGE_PATH" ] || [ ! -s "$IMAGE_PATH" ]; then
  echo "ERROR: Image file not found or empty: $IMAGE_PATH" >&2
  exit 2
fi

TOKEN="$(jq -r '.credentials.openai.access_token // empty' "$AUTH_FILE" 2>/dev/null || true)"
ACCOUNT_ID="$(jq -r '.credentials.openai.account_id // empty' "$AUTH_FILE" 2>/dev/null || true)"

B64_FILE="$(mktemp /tmp/vision-b64.XXXXXX)"
REQ_FILE="$(mktemp /tmp/vision-req.XXXXXX)"

printf 'data:image/jpeg;base64,' > "$B64_FILE"
openssl base64 -A -in "$IMAGE_PATH" >> "$B64_FILE"

jq -nc \
  --arg model "$MODEL" \
  --rawfile img "$B64_FILE" \
  '{
    model: $model,
    instructions: "You are a security camera vision classifier. Reply with a single word: HUMAN if any person or human body part is visible in the image, or NONE if no person is visible.",
    store: false,
    stream: true,
    input: [
      {
        role: "user",
        content: [
          { type: "input_text", text: "Is there a human/person visible in this security camera snapshot? Reply ONLY with HUMAN or NONE." },
          { type: "input_image", image_url: $img }
        ]
      }
    ]
  }' > "$REQ_FILE"

rm -f "$B64_FILE"

RESP_RAW="$(curl -fsSL -X POST "https://chatgpt.com/backend-api/codex/responses" \
  -H "Authorization: Bearer $TOKEN" \
  -H "Chatgpt-Account-Id: $ACCOUNT_ID" \
  -H "OpenAI-Beta: responses=experimental" \
  -H "Content-Type: application/json" \
  --max-time 25 \
  -d @"$REQ_FILE" 2>/dev/null || true)"

rm -f "$REQ_FILE"

VERDICT="$(printf '%s\n' "$RESP_RAW" | awk -F 'data: ' '/^data: \{/ {print $2}' | jq -r 'select(.type == "response.output_text.done") | .text // empty' 2>/dev/null | head -n 1 | tr '[:lower:]' '[:upper:]' | tr -d '[:space:]')"

echo "Vision model ($MODEL) verdict: ${VERDICT:-UNKNOWN}"

case "$VERDICT" in
  *HUMAN*|*YES*) exit 0 ;;
  *) exit 1 ;;
esac
