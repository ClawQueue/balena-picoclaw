#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# vision-human-check:
#   - Default mode: Queries Cloud Vision LLM (gpt-6-luna via PicoClaw OAuth).
#       Exits: 0 = HUMAN, 1 = NONE, 3 = OFFLINE / TIMEOUT / API UNREACHABLE
#   - Cascade mode (--cascade <image.jpg> [bg.jpg]):
#       1) Runs local NCNN human detector (/usr/local/bin/local-human-detect)
#       2) High confidence (>= LOCAL_HIGH_CONF) -> Exits 0 immediately (no cloud)
#       3) Low confidence  (<  LOCAL_LOW_CONF)  -> Exits 1 immediately (no cloud)
#       4) Grey-zone       -> Queries Cloud Vision LLM if online; falls back to
#                             LOCAL_OFFLINE_CONF if offline/unreachable.
# ==============================================================================

MODE="cloud"
if [ "${1:-}" = "--cascade" ]; then
  MODE="cascade"
  shift
fi

IMAGE_PATH="${1:?Usage: vision-human-check [--cascade] /path/to/snapshot.jpg [/path/to/bg.jpg]}"
BG_PATH="${2:-}"
AUTH_FILE="${PICOCLAW_HOME:-/root/.picoclaw}/auth.json"
MODEL="${VISION_MODEL:-gpt-6-luna}"
VISION_TIMEOUT="${VISION_TIMEOUT:-6}"

LOCAL_HIGH_CONF="${LOCAL_HIGH_CONF:-0.65}"
LOCAL_LOW_CONF="${LOCAL_LOW_CONF:-0.15}"
LOCAL_RAW_FALLBACK_CONF="${LOCAL_RAW_FALLBACK_CONF:-0.45}"
LOCAL_OFFLINE_CONF="${LOCAL_OFFLINE_CONF:-0.30}"

if [ ! -f "$IMAGE_PATH" ] || [ ! -s "$IMAGE_PATH" ]; then
  echo "ERROR: Image file not found or empty: $IMAGE_PATH" >&2
  exit 2
fi

run_cloud_check() {
  if [ ! -f "$AUTH_FILE" ]; then
    echo "WARN: OAuth credentials not found at $AUTH_FILE" >&2
    return 3
  fi

  local TOKEN ACCOUNT_ID B64_FILE REQ_FILE RESP_RAW CURL_EXIT VERDICT
  TOKEN="$(jq -r '.credentials.openai.access_token // empty' "$AUTH_FILE")"
  ACCOUNT_ID="$(jq -r '.credentials.openai.account_id // empty' "$AUTH_FILE")"

  if [ -z "$TOKEN" ]; then
    echo "WARN: No OpenAI access_token in $AUTH_FILE" >&2
    return 3
  fi

  B64_FILE="$(mktemp /tmp/vision-b64.XXXXXX)"
  REQ_FILE="$(mktemp /tmp/vision-req.XXXXXX)"

  printf 'data:image/jpeg;base64,' > "$B64_FILE"
  openssl base64 -A -in "$IMAGE_PATH" >> "$B64_FILE"

  jq -nc \
    --arg model "$MODEL" \
    --rawfile img "$B64_FILE" \
    '{
      model: $model,
      instructions: "You are a security camera vision classifier. Reply with a single word: HUMAN if any person or human body part is visible in the image, or NONE if no person is visible.",
      store: false,
      stream: true,
      input: [
        {
          role: "user",
          content: [
            { type: "input_text", text: "Is there a human/person visible in this security camera snapshot? Reply ONLY with HUMAN or NONE." },
            { type: "input_image", image_url: $img }
          ]
        }
      ]
    }' > "$REQ_FILE"

  rm -f "$B64_FILE"

  CURL_EXIT=0
  RESP_RAW="$(curl -fsSL -X POST "https://chatgpt.com/backend-api/codex/responses" \
    -H "Authorization: Bearer $TOKEN" \
    -H "Chatgpt-Account-Id: $ACCOUNT_ID" \
    -H "OpenAI-Beta: responses=experimental" \
    -H "Content-Type: application/json" \
    --connect-timeout 2 \
    --max-time "$VISION_TIMEOUT" \
    -d @"$REQ_FILE" 2>/dev/null)" || CURL_EXIT=$?

  rm -f "$REQ_FILE"

  if [ "$CURL_EXIT" -ne 0 ] || [ -z "$RESP_RAW" ]; then
    echo "Cloud Vision ($MODEL) unreachable or timed out (curl exit $CURL_EXIT, timeout ${VISION_TIMEOUT}s)"
    return 3
  fi

  VERDICT="$(printf '%s\n' "$RESP_RAW" | awk -F 'data: ' '/^data: \{/ {print $2}' | jq -r 'select(.type == "response.output_text.done") | .text // empty' 2>/dev/null | head -n 1 | tr '[:lower:]' '[:upper:]' | tr -d '[:space:]')"

  if [ -z "$VERDICT" ]; then
    echo "Cloud Vision ($MODEL) returned empty verdict (auth or network error)"
    return 3
  fi

  echo "Cloud Vision ($MODEL) verdict: $VERDICT"
  case "$VERDICT" in
    *HUMAN*|*YES*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

if [ "$MODE" = "cloud" ]; then
  run_cloud_check
  exit $?
fi

# ==============================================================================
# Cascade Mode: Tier 1 (Local NCNN on Orange Pi) -> Tier 2 (Cloud LLM / Offline)
# ==============================================================================
LOCAL_JSON="${LOCAL_DETECT_JSON:-/tmp/local_detect.json}"
if [ ! -s "$LOCAL_JSON" ]; then
  if [ -n "$BG_PATH" ] && [ -s "$BG_PATH" ]; then
    /usr/local/bin/local-human-detect "$IMAGE_PATH" "$BG_PATH" > "$LOCAL_JSON"
  else
    /usr/local/bin/local-human-detect "$IMAGE_PATH" > "$LOCAL_JSON"
  fi
fi

CONF="$(jq -r '.confidence // 0' "$LOCAL_JSON")"
RAW_CONF="$(jq -r '.raw_confidence // 0' "$LOCAL_JSON")"
INF_MS="$(jq -r '.inference_ms // 0' "$LOCAL_JSON")"

echo "[Tier 1 Local NCNN] moving_confidence=$CONF, raw_confidence=$RAW_CONF, inference_ms=${INF_MS}ms"

DECISION="$(awk -v c="$CONF" -v rc="$RAW_CONF" -v hi="$LOCAL_HIGH_CONF" -v lo="$LOCAL_LOW_CONF" -v rfb="$LOCAL_RAW_FALLBACK_CONF" '
BEGIN {
  if (c + 0.0 >= hi + 0.0) {
    print "HIGH"
  } else if (c + 0.0 >= lo + 0.0 || rc + 0.0 >= rfb + 0.0) {
    print "GREY"
  } else {
    print "LOW"
  }
}')"

if [ "$DECISION" = "HIGH" ]; then
  echo "[Tier 1 -> FAST TRIGGER] Confidence $CONF >= $LOCAL_HIGH_CONF. Human confirmed locally (skipping Cloud LLM)!"
  exit 0
fi

if [ "$DECISION" = "LOW" ]; then
  echo "[Tier 1 -> FAST REJECT] Confidence $CONF < $LOCAL_LOW_CONF (raw $RAW_CONF < $LOCAL_RAW_FALLBACK_CONF). Non-human motion rejected locally (skipping Cloud LLM)!"
  exit 1
fi

echo "[Tier 1 -> GREY ZONE] Confidence $CONF in [$LOCAL_LOW_CONF, $LOCAL_HIGH_CONF) (or raw $RAW_CONF >= $LOCAL_RAW_FALLBACK_CONF). Escalating to Tier 2 Cloud Vision LLM ($MODEL)..."

CLOUD_RC=0
run_cloud_check || CLOUD_RC=$?

if [ "$CLOUD_RC" -eq 0 ]; then
  echo "[Tier 2 Cloud LLM] Confirmed HUMAN."
  exit 0
elif [ "$CLOUD_RC" -eq 1 ]; then
  echo "[Tier 2 Cloud LLM] Confirmed NONE (false alarm filtered)."
  exit 1
else
  echo "[Tier 2 Offline Fallback] Cloud unreachable/timed out (rc=$CLOUD_RC). Evaluating local confidence $CONF against offline threshold $LOCAL_OFFLINE_CONF..."
  OFFLINE_PASS="$(awk -v c="$CONF" -v rc="$RAW_CONF" -v off="$LOCAL_OFFLINE_CONF" 'BEGIN { print (c + 0.0 >= off + 0.0 || rc + 0.0 >= 0.60) ? "1" : "0" }')"
  if [ "$OFFLINE_PASS" = "1" ]; then
    echo "[Tier 2 Offline Fallback] Local confidence sufficient -> Triggering HUMAN action offline!"
    exit 0
  else
    echo "[Tier 2 Offline Fallback] Local confidence below offline threshold -> Ignoring."
    exit 1
  fi
fi
