# Optional git-ignored environment overrides loaded by /app/start.sh
# Copy to gateway/secrets/secrets.env (or /data/picoclaw/secrets/secrets.env on device)

# Extra Alpine packages to install at container startup (e.g. for LAN SSH/discovery)
# PICOCLAW_EXTRA_PKGS="openssh-client iputils nmap"

# Fixed credentials (optional)
# PICOCLAW_DASHBOARD_PASSWORD=""
# PICOCLAW_GATEWAY_TOKEN=""
